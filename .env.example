################################################################
# SHELTER ACCORD — Environment Variables
# Скопіюйте у .env і відредагуйте всі значення.
#
# Генерація JWT_SECRET:
#   openssl rand -base64 32
#
# Генерація ANON_KEY / SERVICE_ROLE_KEY:
#   https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
################################################################

# ── Postgres ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── JWT / API Keys ────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# ANON_KEY payload: {"role":"anon","iss":"supabase","iat":1713000000,"exp":2028000000}
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlhdCI6MTYxMzUzMTk4NSwiZXhwIjo0NzY5MjA1OTg1fQ.placeholder

# SERVICE_ROLE_KEY payload: {"role":"service_role","iss":"supabase","iat":1713000000,"exp":2028000000}
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaWF0IjoxNjEzNTMxOTg1LCJleHAiOjQ3NjkyMDU5ODV9.placeholder

# ── Supabase URLs ─────────────────────────────────────────────────
# Dev (localhost):
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000

# Prod: замініть на свій домен (через nginx-proxy)
# SUPABASE_URL=https://yourdomain.com/supabase
# SUPABASE_PUBLIC_URL=https://yourdomain.com/supabase
# API_EXTERNAL_URL=https://yourdomain.com/supabase

# ── Production domain (для nginx.prod.conf) ───────────────────────
DOMAIN=yourdomain.com

# ── Studio (опціонально, вимкнено в продакшні) ────────────────────
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=your-admin-password

# ── SMTP (optional, для auth emails) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Shelter Accord

# ── Web App (Expo) ────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=http://localhost:8000
EXPO_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}

# Prod:
# EXPO_PUBLIC_SUPABASE_URL=https://yourdomain.com/supabase
# EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# ── Admin Panel (Next.js) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=${ANON_KEY}
ADMIN_EMAIL=admin@shelter-accord.com
ADMIN_PASSWORD=admin-password-change-me
